    "load-test": "vite build && node scripts/load-test.mjs",
    "typecheck": "tsc -p . && tsc -p test"
  },
  "dependencies": {
    "@duty-shooter/fps-core": "^0.0.0",
    "@duty-shooter/range": "^0.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
