# Copy to .env next to compose.yaml on the server and fill in. Never commit .env.
# Leave empty for one public lobby that anyone with the link can join.
# Set it to make every player type this passphrase on the join screen instead.
PASSPHRASE=
# Player cap (1-32).
MAX_PLAYERS=8
# Host port, bound to 127.0.0.1 only; Tailscale Funnel proxies to it.
DUTY_PORT=3090
