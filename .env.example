# Copy to .env next to compose.yaml on the server and fill in. Never commit .env.
# Leave empty for one public lobby that anyone with the link can join.
# Set it to make every player type this passphrase on the join screen instead.
PASSPHRASE=
# Player cap, bots included (1-32).
MAX_PLAYERS=12
# The map and mode an empty server starts in; the host picks both in the lobby after that.
# Maps: survival-town, switchyard or range. Modes: tdm, ffa, outposts or charge.
MAP=survival-town
MODE=tdm
# Seconds per match, for short matches (10-3600). Empty: each mode's own limit. Charge ignores it.
TIME_LIMIT=
# Bots fill each side up to this many while anyone plays (0 to MAX_BOTS_PER_TEAM; the host can change it).
# People take a bot's seat when they join, and the bots leave with the last person.
BOTS_PER_TEAM=3
# The most bots a side the host may pick (0-6). For no bots, set this and BOTS_PER_TEAM to 0.
MAX_BOTS_PER_TEAM=6
# Pins the image (see docs/deploy.md, "Pinning the live version"). Empty: the :latest image, kept up to date.
# DUTY_IMAGE=ghcr.io/aleixribera/duty-shooter:v2.0.0
# Host port, bound to 127.0.0.1 only; Tailscale Funnel proxies to it.
DUTY_PORT=3090
