# Copy to .env next to compose.yaml on the server and fill in. Never commit .env.
# Leave empty for one public lobby that anyone with the link can join.
# Set it to make every player type this passphrase on the join screen instead.
PASSPHRASE=
# Player cap (1-32).
MAX_PLAYERS=8
# The lobby's map (survival-town or range) and the mode an empty server starts in (tdm or ffa).
MAP=survival-town
MODE=tdm
# Seconds per match, for short matches (10-3600). Empty: 10 minutes, or the kill limit first.
TIME_LIMIT=
# Bots fill each side up to this many while anyone plays (0-4; 0 = none unless the first player asks).
# People take a bot's seat when they join, and the bots leave with the last person. Survival Town only.
BOTS_PER_TEAM=3
# The most bots a side the first player on an empty server may pick (0-4; 0 turns bots off).
MAX_BOTS_PER_TEAM=4
# Pins the image (see docs/deploy.md, "Pinning the live version"). Empty: the :latest image, kept up to date.
# DUTY_IMAGE=ghcr.io/aleixribera/duty-shooter:v2.0.0
# Host port, bound to 127.0.0.1 only; Tailscale Funnel proxies to it.
DUTY_PORT=3090
