{
  "name": "duty-shooter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @duty-shooter/range --",
    "server": "npm run serve -w @duty-shooter/server",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run packages/fps-core",
    "test:client": "vitest run packages/fps-client",
    "test:range": "vitest run apps/range",
    "test:range:island-nav": "vitest run apps/range/test/zero-island-nav",
    "test:range:royale": "vitest run apps/range/test/zero-island-royale.test",
    "test:range:island": "vitest run apps/range/test/zero-island --exclude \"**/zero-island-nav*\" --exclude \"**/zero-island-royale.test*\" --exclude \"**/zero-island-bots*\" --exclude \"**/zero-island-royale-bots*\"",
    "test:range:bots": "vitest run apps/range/test/zero-island-bots apps/range/test/zero-island-royale-bots apps/range/test/survival-town",
    "test:range:rest": "vitest run apps/range --exclude \"**/zero-island*\" --exclude \"**/survival-town*\"",
    "test:server": "vitest run apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bench": "node apps/range/scripts/bench.mjs",
    "spots": "node apps/range/scripts/spots.mjs",
    "bot-runs": "node apps/range/scripts/bot-runs.mjs",
    "record": "node apps/range/scripts/record.mjs",
    "smoke": "node apps/server/scripts/smoke.mjs",
    "load-test": "npm run load-test -w @duty-shooter/server --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
