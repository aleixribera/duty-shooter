{
  "name": "duty-shooter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @duty-shooter/range --",
    "server": "npm run serve -w @duty-shooter/server",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "test": "vitest run --project fast",
    "test:soak": "vitest run --project soak",
    "test:all": "vitest run",
    "test:watch": "vitest --project fast",
    "test:core": "vitest run --project fast packages/fps-core",
    "test:client": "vitest run --project fast packages/fps-client",
    "test:range": "vitest run --project fast apps/range",
    "test:server": "vitest run --project fast apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bench": "node apps/range/scripts/bench.mjs",
    "spots": "node apps/range/scripts/spots.mjs",
    "bot-runs": "node apps/range/scripts/bot-runs.mjs",
    "record": "node apps/range/scripts/record.mjs",
    "smoke": "node apps/server/scripts/smoke.mjs",
    "load-test": "npm run load-test -w @duty-shooter/server --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
